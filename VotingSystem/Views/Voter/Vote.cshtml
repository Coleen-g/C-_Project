@model IEnumerable<VotingSystem.Models.Candidates>

@{
    ViewData["Title"] = "Vote";
    Layout = "_VoterLayout";
    var votedPositions = ViewBag.VotedPositions as List<string> ?? new List<string>();
    var votedSenators = ViewBag.VotedSenators as List<int> ?? new List<int>(); // IDs of voted senators
    var maxSenatorVotes = 2;
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="text-center mb-4">
        <h2 class="fw-bold text-success">
            <i class="bi bi-hand-thumbs-up-fill me-2"></i>Cast Your Vote
        </h2>
        <p class="text-muted fs-6">Select your preferred candidates for each position below</p>
    </div>

    <!-- Success Message -->
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show text-center shadow-sm mb-4 rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Candidate Groups -->
    @foreach (var group in Model.GroupBy(c => c.Position))
    {
        <div class="mb-5" data-position="@group.Key">
            <h3 class="text-success fw-bold mb-3 text-center position-title">
                <i class="bi bi-person-badge-fill me-2"></i>@group.Key
            </h3>

            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var candidate in group)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0 rounded-4 hover-card">
                            <div class="card-body d-flex flex-column justify-content-between text-center p-4">
                                <div>
                                    <h5 class="card-title fw-bold text-success">@candidate.Name</h5>
                                    <p class="text-muted mb-3 fs-6">
                                        <i class="bi bi-flag-fill me-1"></i>@candidate.Party
                                    </p>
                                    @if (!string.IsNullOrEmpty(candidate.ImagePath))
                                    {
                                        <img src="@candidate.ImagePath" class="img-fluid rounded-3 mb-2" />
                                    }
                                </div>
                                <div>
                                    @{
                                        bool disableButton = false;

                                        if (group.Key.ToLower() == "senator")
                                        {
                                            // Disable if already voted maxSenatorVotes
                                            disableButton = votedSenators.Count >= maxSenatorVotes || votedSenators.Contains(candidate.Id);
                                        }
                                        else
                                        {
                                            disableButton = votedPositions.Contains(candidate.Position);
                                        }
                                    }

                                    <form asp-controller="Voter" asp-action="Vote" method="post">
                                        <input type="hidden" name="candidateId" value="@candidate.Id" />
                                        <button type="submit" class="btn @(disableButton ? "btn-secondary" : "btn-success") w-100 fw-bold shadow-sm" @(disableButton ? "disabled" : "")>
                                            <i class="bi bi-hand-thumbs-up me-1"></i>
                                            @(disableButton ? (group.Key.ToLower() == "senator" ? "Already Voted" : "Already Voted") : "Vote")
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Optional: You can dynamically fetch updated candidates
        // and implement multi-senator vote logic with JS if needed.
    </script>
}
