    @model IEnumerable<VotingSystem.Models.Candidates>

    <div class="container mt-5">
        <h1 class="mb-4 text-primary text-center fw-bold">Election Results</h1>

        @if (!Model.Any())
        {
            <div class="alert alert-info text-center">
                <i class="bi bi-info-circle-fill me-2"></i>No votes have been cast yet.
            </div>
        }
        else
        {
            @foreach (var group in Model.GroupBy(c => c.Position))
            {
                <div class="mb-5">
                    <h3 class="mb-3 text-secondary fw-semibold">@group.Key</h3>
                    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                        @foreach (var candidate in group.OrderByDescending(c => c.Votes))
                        {
                            <div class="col">
                                <div class="card h-100 shadow-sm border-0 rounded-4">
                                    <div class="card-body d-flex flex-column justify-content-between">
                                        <div>
                                            <h5 class="card-title fw-bold">@candidate.Name</h5>
                                            <p class="card-text text-muted mb-2">
                                                <i class="bi bi-flag-fill me-1"></i> @candidate.Party
                                            </p>
                                            <p class="card-text">
                                                <span class="badge bg-success fs-6">
                                                    <i class="bi bi-bar-chart-line me-1"></i> @candidate.Votes Votes
                                                </span>
                                            </p>
                                        </div>
                                        @* Highlight winner *@
                                        @if (candidate.Votes == group.Max(c => c.Votes))
                                        {
                                            <span class="badge bg-primary text-white mt-3 p-2 w-100 fs-6 fw-semibold text-center">
                                                <i class="bi bi-trophy-fill me-1"></i> Winner
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
