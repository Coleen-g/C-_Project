@model VotingSystem.Models.Voter
@{
    ViewData["Title"] = "Voter Dashboard";
    Layout = "~/Views/Shared/_VoterLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- Welcome Card -->
    <div class="card shadow-lg border-0 rounded-4 mb-4">
        <div class="card-body p-5 text-center">
            <i class="bi bi-person-check-fill text-success fs-1 mb-3"></i>
            <h2 class="fw-bold mb-2">Welcome, @Model.FullName!</h2>
            <p class="text-muted fs-6">
                You are logged in and eligible to participate in the election. Review the information below before casting your vote.
            </p>
        </div>
    </div>

    <div class="row g-4">

        <!-- Election Information -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-primary bg-gradient text-white rounded-top-4 py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-info-circle-fill me-2"></i>Election Information
                    </h5>
                </div>
                <div class="card-body p-4">
                    <ul class="list-unstyled mb-0 fs-6">
                        <li><strong>Election Title:</strong> TMC Student Council Election 2025</li>
                        <li><strong>Voting Period:</strong> October 20 - October 25, 2025</li>
                        <li>
                            <strong>Status:</strong>
                            <span class="badge bg-success">Ongoing</span>
                        </li>
                        <li><strong>Deadline:</strong> October 25, 2025 (11:59 PM)</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Voter Details -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-primary bg-gradient text-white rounded-top-4 py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-person-badge-fill me-2"></i>Your Voter Details
                    </h5>
                </div>
                <div class="card-body p-4">
                    <ul class="list-unstyled mb-0 fs-6">
                        <li><strong>Voter ID:</strong> @Model.VoterCode</li>
                        <li><strong>Name:</strong> @Model.FullName</li>
                        <li>
                            <strong>Status:</strong>
                            @if (Model.HasVoted)
                            {
                                <span class="badge bg-success">Voted</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Not Yet Voted</span>
                            }
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Call to Action -->
    <div class="text-center mt-5">
        <h4 class="fw-bold text-secondary mb-2">Ready to Cast Your Vote?</h4>
        <p class="text-muted mb-4 fs-6">
            Review all candidates carefully before submitting your vote. Once submitted, votes cannot be changed.
        </p>
        <a asp-controller="Voter" asp-action="Vote" class="btn btn-lg btn-success px-5 py-2 shadow-sm rounded-3">
            <i class="bi bi-check2-circle me-2"></i>Vote Now
        </a>
    </div>

</div>
