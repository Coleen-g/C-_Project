@{
    ViewData["Title"] = "Register Voter";
}

@if (TempData["Error"] != null)
{
    <script>
        alert("@TempData["Error"]");
    </script>
}

@if (TempData["Success"] != null)
{
    <script>
        alert("@TempData["Success"]");
    </script>
}

<div class="d-flex justify-content-center align-items-center vh-100" style="background: linear-gradient(135deg, #007bff, #00c6ff);">
    <div class="card shadow-lg border-0 rounded-4" style="width: 420px;">
        <div class="card-body p-5">

            <!-- System Logo & Name -->
            <div class="text-center mb-4">
                <i class="fa-solid fa-vote-yea text-primary fs-1 mb-2"></i>
                <h2 class="fw-bold text-primary">Votium</h2>
                <p class="text-muted mb-0">Secure Online Voting System</p>
            </div>

            <h4 class="text-center text-secondary fw-semibold mb-4">
                <i class="bi bi-person-plus-fill me-2 text-primary"></i>Voter Registration
            </h4>

            <form asp-action="Register" method="post">

                <!-- 🔴 MESSAGE INSIDE FORM -->
                @if (ViewBag.Error != null)
                {
                    <div style="color: red; text-align:center; font-weight:bold; margin-bottom: 12px;">
                        @ViewBag.Error
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label fw-semibold">Full Name</label>
                    <div class="input-group shadow-sm rounded-3">
                        <span class="input-group-text bg-primary text-white rounded-start">
                            <i class="bi bi-person-fill"></i>
                        </span>
                        <input type="text" name="fullName" class="form-control rounded-end" placeholder="Enter full name" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Username</label>
                    <div class="input-group shadow-sm rounded-3">
                        <span class="input-group-text bg-primary text-white rounded-start">
                            <i class="bi bi-at"></i>
                        </span>
                        <input type="text" name="username" class="form-control rounded-end" placeholder="Choose a username" required />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Password</label>
                    <div class="input-group shadow-sm rounded-3">
                        <span class="input-group-text bg-primary text-white rounded-start">
                            <i class="bi bi-lock-fill"></i>
                        </span>
                        <input type="password" name="password" class="form-control rounded-end" placeholder="Enter password" required />
                    </div>
                </div>

                <div class="d-grid gap-2 mb-3">
                    <button type="submit" class="btn btn-primary py-3 fw-semibold shadow-sm rounded-pill fs-5">
                        <i class="bi bi-person-plus-fill me-1"></i>Register
                    </button>
                </div>


                <div class="text-center">
                    <p class="mb-0 text-secondary">
                        Already have an account?
                        <a asp-action="Login" class="text-primary fw-semibold text-decoration-none">
                            Login here
                        </a>
                    </p>
                </div>
            </form>

        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
