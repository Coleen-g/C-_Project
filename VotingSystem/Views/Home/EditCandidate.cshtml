@model VotingSystem.Models.Candidates

@{
    ViewData["Title"] = "Edit Candidate";
}

<div class="container mt-5">
    <h1 class="mb-4 text-warning fw-bold">Edit Candidate</h1>

    <form asp-action="EditCandidate" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Party" class="form-label"></label>
            <input asp-for="Party" class="form-control" />
            <span asp-validation-for="Party" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Position" class="form-label"></label>
            <input asp-for="Position" class="form-control" />
            <span asp-validation-for="Position" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-warning">Update Candidate</button>
        <a asp-action="Candidates" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
