@{
    ViewData["Title"] = "Voter Dashboard";
}

<div class="container mt-5">
    <h1 class="fw-bold text-success mb-4">Voter Dashboard</h1>

    <div class="alert alert-success">
        Welcome, <strong>Voter!</strong> You can now view candidates and cast your vote.
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body text-center">
            <h5 class="card-title fw-bold">Cast Your Vote</h5>
            <p class="card-text">Click the button below to view the candidates and submit your vote.</p>
            <a href="#" class="btn btn-success">Vote Now</a>
        </div>
    </div>
</div>
