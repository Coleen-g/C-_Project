@model VotingSystem.Models.Candidates

@{
    ViewData["Title"] = "Add Candidate";
    var positions = ViewBag.Positions as List<string>;
}

<div class="container mt-5">
    <h1 class="mb-4 text-success">Add New Candidate</h1>

    <form asp-action="AddCandidate" method="post">
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Party" class="form-label"></label>
            <input asp-for="Party" class="form-control" />
            <span asp-validation-for="Party" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Position" class="form-label"></label>
            <select asp-for="Position" class="form-control" asp-items="@(new SelectList(positions))">
                <option value="">-- Select Position --</option>
            </select>
            <span asp-validation-for="Position" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success">Save Candidate</button>
        <a asp-action="AdminDashboard" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
