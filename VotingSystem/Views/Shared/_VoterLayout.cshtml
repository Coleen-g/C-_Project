<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Voter Dashboard</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        body {
            display: flex;
            min-height: 100vh;
            background-color: #f8f9fa;
            margin: 0;
            overflow-x: hidden;
        }

        /* ===== Sidebar ===== */
        .sidebar {
            width: 250px;
            background-color: #212529;
            color: #fff;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            padding-top: 1rem;
        }

            .sidebar h3 {
                text-align: center;
                font-weight: bold;
                color: #fff;
                margin-bottom: 1.5rem;
            }

            .sidebar a {
                display: flex;
                align-items: center;
                color: #adb5bd;
                padding: 12px 20px;
                text-decoration: none;
                font-weight: 500;
                transition: all 0.3s;
                border-radius: 8px;
                margin: 4px 10px;
            }

                .sidebar a i {
                    margin-right: 12px;
                    font-size: 1.1rem;
                }

                .sidebar a:hover, .sidebar a.active {
                    background-color: #0d6efd;
                    color: #fff;
                }

        /* ===== Content Area ===== */
        .main-content {
            flex-grow: 1;
            margin-left: 250px;
            display: flex;
            flex-direction: column;
        }

        /* ===== Top Navbar ===== */
        .top-navbar {
            background-color: #fff;
            border-bottom: 1px solid #dee2e6;
            padding: 0.75rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .navbar-left h5 {
            margin: 0;
            font-weight: 600;
            color: #343a40;
        }

        /* Avatar (like Gmail) */
        .navbar-right {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

            .navbar-right .avatar {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                overflow: hidden;
                border: 2px solid #0d6efd;
            }

                .navbar-right .avatar img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }

            .navbar-right span {
                font-weight: 500;
                color: #212529;
            }

        /* ===== Body Content ===== */
        .content {
            padding: 2rem;
            flex-grow: 1;
            background-color: #f8f9fa;
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <h3><i class="bi bi-person-badge me-2"></i>Voter Panel</h3>
        <a asp-controller="Voter" asp-action="VoterDashboard" class="@(ViewData["Title"]?.ToString() == "Dashboard" ? "active" : "")">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>
        <a asp-controller="Voter" asp-action="Vote" class="@(ViewData["Title"]?.ToString() == "Vote" ? "active" : "")">
            <i class="bi bi-hand-thumbs-up-fill"></i> Vote
        </a>
        <a asp-controller="Voter" asp-action="Results" class="@(ViewData["Title"]?.ToString() == "Results" ? "active" : "")">
            <i class="bi bi-bar-chart-fill"></i> Results
        </a>
        <a asp-controller="Home" asp-action="Logout">
            <i class="bi bi-box-arrow-right"></i> Logout
        </a>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Top Navbar -->
        <div class="top-navbar">
            <div class="navbar-left">
                <h5>@ViewData["Title"]</h5>
            </div>
            <div class="navbar-right">
                <div class="avatar">
                    <img src="~/images/vote1.jpg" alt="User Avatar" />
                </div>
                <span>@User.Identity?.Name</span>
            </div>
        </div>

        <!-- Page Body -->
        <div class="content">
            @RenderBody()
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
