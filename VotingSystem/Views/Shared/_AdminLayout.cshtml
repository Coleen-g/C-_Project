@{
    var activePage = ViewBag.Active as string ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        body {
            background-color: #f8f9fa;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        }

        /* Sidebar */
        .sidebar {
            width: 250px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background: #212529;
            color: #fff;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: all 0.3s;
        }

        .sidebar-header {
            text-align: center;
            padding: 1.5rem 1rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

            .sidebar-header h3 {
                font-size: 1.4rem;
                font-weight: 700;
            }

        .nav-link {
            color: #adb5bd;
            padding: 0.75rem 1rem;
            border-radius: 0.375rem;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .nav-link:hover,
            .nav-link.active {
                background-color: #0d6efd;
                color: #fff;
            }

            .nav-link i {
                font-size: 1.1rem;
            }

        .main-content {
            margin-left: 250px;
            padding: 2rem;
            transition: all 0.3s;
        }

        @@media (max-width: 992px) {
            .sidebar {
                width: 70px;
            }

            .sidebar-header h3 {
                display: none;
            }

            .nav-link span {
                display: none;
            }

            .main-content {
                margin-left: 70px;
            }
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <div>
            <div class="sidebar-header">
                <h3><i class="bi bi-person-gear me-2"></i>Admin</h3>
            </div>

            <ul class="nav flex-column px-2 mt-3">
                <!-- Dashboard -->
                <li class="nav-item mb-2">
                    <a asp-controller="Admin" asp-action="AdminDashboard"
                       class="nav-link @(activePage == "AdminDashboard" ? "active" : "")">
                        <i class="bi bi-speedometer2"></i> <span>Dashboard</span>
                    </a>
                </li>

                <!-- Admin Controls Dropdown -->
                <li class="nav-item mb-2">
                    <a class="nav-link d-flex justify-content-between align-items-center"
                       data-bs-toggle="collapse" href="#adminControls" role="button"
                       aria-expanded="false" aria-controls="adminControls" id="adminControlsToggle">
                        <span><i class="bi bi-gear-fill me-2"></i>Admin Controls</span>
                        <i class="bi bi-chevron-down"></i>
                    </a>
                    <div class="collapse" id="adminControls">
                        <ul class="nav flex-column ms-3 mt-2">
                            <li class="nav-item mb-1">
                                <a asp-controller="Admin" asp-action="AddCandidate" class="nav-link @(activePage == "AddCandidate" ? "active" : "")">
                                    <i class="bi bi-person-plus-fill me-1"></i> Add Candidates
                                </a>
                            </li>
                            <li class="nav-item mb-1">
                                <a asp-controller="Admin" asp-action="ManageVoters" class="nav-link @(activePage == "ManageVoters" ? "active" : "")">
                                    <i class="bi bi-person-check-fill me-1"></i> Manage Voters
                                </a>
                            </li>
                            <li class="nav-item mb-1">
                                <a asp-controller="Admin" asp-action="Candidates" class="nav-link @(activePage == "Candidates" ? "active" : "")">
                                    <i class="bi bi-people-fill me-1"></i> View Candidates
                                </a>
                            </li>
                            <li class="nav-item mb-1">
                                <a asp-controller="Admin" asp-action="Results" class="nav-link @(activePage == "Results" ? "active" : "")">
                                    <i class="bi bi-bar-chart-fill me-1"></i> Results
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>

                <!-- Voter Logs -->
                <li class="nav-item mb-2">
                    <a asp-controller="Admin" asp-action="UserLogs" class="nav-link @(activePage == "UserLogs" ? "active" : "")">
                        <i class="bi bi-person-lines-fill"></i> <span>Voter Logs</span>
                    </a>
                </li>
            </ul>
        </div>

        <div class="p-3 border-top border-secondary">
            <a asp-controller="Home" asp-action="Logout" class="nav-link text-danger">
                <i class="bi bi-box-arrow-right"></i> <span>Logout</span>
            </a>
        </div>
    </div>

    <div class="main-content">
        @RenderBody()
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const adminToggle = document.getElementById('adminControlsToggle');
        const adminCollapse = document.getElementById('adminControls');

        // Restore state on page load
        if (localStorage.getItem('adminControlsOpen') === 'true') {
            adminCollapse.classList.add('show');
        }

        // Save state when toggled
        adminToggle.addEventListener('click', () => {
            setTimeout(() => {
                const isOpen = adminCollapse.classList.contains('show');
                localStorage.setItem('adminControlsOpen', isOpen);
            }, 300); // wait for collapse animation
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
