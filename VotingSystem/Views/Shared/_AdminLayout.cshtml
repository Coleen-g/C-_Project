@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        body {
            background-color: #f8f9fa;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        }

        /* Sidebar */
        .sidebar {
            width: 250px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background: #212529;
            color: #fff;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: all 0.3s;
        }

        .sidebar-header {
            text-align: center;
            padding: 1.5rem 1rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

            .sidebar-header h3 {
                font-size: 1.4rem;
                font-weight: 700;
            }

        .nav-link {
            color: #adb5bd;
            padding: 0.75rem 1rem;
            border-radius: 0.375rem;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .nav-link:hover,
            .nav-link.active {
                background-color: #0d6efd;
                color: #fff;
            }

            .nav-link i {
                font-size: 1.1rem;
            }

        /* Content */
        .main-content {
            margin-left: 250px;
            padding: 2rem;
            transition: all 0.3s;
        }

        /* Responsive */
        @@media (max-width: 992px) {
            .sidebar {
                width: 70px;
            }

            .sidebar-header h3 {
                display: none;
            }

            .nav-link span {
                display: none;
            }

            .main-content {
                margin-left: 70px;
            }
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <div>
            <div class="sidebar-header">
                <h3><i class="bi bi-person-gear me-2"></i>Admin</h3>
            </div>

            <ul class="nav flex-column px-2 mt-3">
                <li class="nav-item mb-2">
                    <a asp-controller="Admin" asp-action="AdminDashboard"
                       class="nav-link @(ViewBag.Active == "AdminDashboard" ? "active" : "")">
                        <i class="bi bi-speedometer2"></i> <span>Dashboard</span>
                    </a>
                </li>

                <li class="nav-item mb-2">
                    <a asp-controller="Admin" asp-action="AddCandidate"
                       class="nav-link @(ViewBag.Active == "AddCandidate" ? "active" : "")">
                        <i class="bi bi-person-plus-fill"></i> <span>Add Candidates</span>
                    </a>
                </li>

                <li class="nav-item mb-2">
                    <a asp-controller="Admin" asp-action="Candidates"
                       class="nav-link @(ViewBag.Active == "Candidates" ? "active" : "")">
                        <i class="bi bi-people-fill"></i> <span>View Candidates</span>
                    </a>
                </li>

                <li class="nav-item mb-2">
                    <a asp-controller="Admin" asp-action="Results"
                       class="nav-link @(ViewBag.Active == "Results" ? "active" : "")">
                        <i class="bi bi-bar-chart-fill"></i> <span>Results</span>
                    </a>
                </li>

                <li class="nav-item mb-2">
                    <a asp-controller="Admin" asp-action="UserLogs"
                       class="nav-link @(ViewBag.Active == "UserLogs" ? "active" : "")">
                        <i class="bi bi-person-lines-fill"></i> <span>Voter Logs</span>
                    </a>
                </li>
            </ul>
        </div>

        <div class="p-3 border-top border-secondary">
            <a asp-controller="Home" asp-action="Logout" class="nav-link text-danger">
                <i class="bi bi-box-arrow-right"></i> <span>Logout</span>
            </a>
        </div>
    </div>

    <div class="main-content">
        @RenderBody()
    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>
