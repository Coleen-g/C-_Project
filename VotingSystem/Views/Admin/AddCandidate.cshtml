@model VotingSystem.Models.Candidates

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add Candidate";
    ViewBag.Active = "AddCandidate"; // Highlight in sidebar
    var positions = ViewBag.Positions as List<string> ?? new List<string>();
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 px-3 py-2 rounded-3 shadow-sm bg-white border">
        <div class="d-flex align-items-center">
            <div class="me-2">
                <i class="bi bi-person-plus-fill fs-3 text-primary"></i>
            </div>
            <div>
                <h4 class="fw-bold text-primary mb-0">Add New Candidate</h4>
                <p class="text-muted mb-0 small">Register a new candidate for the election</p>
            </div>
        </div>
        <a class="btn btn-outline-primary btn-sm rounded-pill" asp-action="Candidates">
            <i class="bi bi-people-fill me-1"></i> View All Candidates
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card rounded-4 shadow-sm">
                <div class="card-body p-5">
                    <h5 class="fw-semibold text-primary mb-4">
                        <i class="bi bi-pencil-square me-2"></i> Candidate Information
                    </h5>

                    <form id="addCandidateForm" asp-action="AddCandidate" method="post" enctype="multipart/form-data">
                        <!-- Candidate Name -->
                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-semibold">
                                <i class="bi bi-person-fill me-2"></i>Candidate Name
                            </label>
                            <input asp-for="Name" class="form-control form-control-lg rounded-3 shadow-sm" placeholder="Enter candidate name" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <!-- Party -->
                        <div class="mb-4">
                            <label asp-for="Party" class="form-label fw-semibold">
                                <i class="bi bi-flag-fill me-2"></i>Party
                            </label>
                            <input asp-for="Party" class="form-control form-control-lg rounded-3 shadow-sm" placeholder="Enter party name" />
                            <span asp-validation-for="Party" class="text-danger small"></span>
                        </div>

                        <!-- Position -->
                        <div class="mb-4">
                            <label asp-for="Position" class="form-label fw-semibold">
                                <i class="bi bi-briefcase-fill me-2"></i>Position
                            </label>

                            <select id="positionDropdown" name="Position" class="form-select form-select-lg rounded-3 shadow-sm" onchange="toggleNewPositionInput(this)">
                                <option value="">-- Select Position --</option>
                                @foreach (var pos in positions)
                                {
                                    <option value="@pos">@pos</option>
                                }
                                <option value="__new">+ Add New Position</option>
                            </select>

                            <input id="newPositionInput" type="text" name="NewPosition" class="form-control mt-2 rounded-3 shadow-sm" placeholder="Enter new position" style="display:none;" />
                            <span asp-validation-for="Position" class="text-danger small"></span>
                        </div>

                        <!-- Candidate Image -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-image-fill me-2"></i>Candidate Image
                            </label>
                            <input asp-for="ImageFile" type="file" class="form-control form-control-lg rounded-3 shadow-sm" />
                            <span asp-validation-for="ImageFile" class="text-danger small"></span>
                        </div>

                        <hr class="my-4">

                        <!-- Buttons -->
                        <div class="d-flex justify-content-end gap-3">
                            <a asp-action="AdminDashboard" class="btn btn-outline-secondary px-4 py-2 rounded-3">
                                <i class="bi bi-arrow-left me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary px-4 py-2 rounded-3">
                                <i class="bi bi-save2 me-1"></i> Save Candidate
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleNewPositionInput(dropdown) {
            const newInput = document.getElementById('newPositionInput');
            if (dropdown.value === '__new') {
                newInput.style.display = 'block';
            } else {
                newInput.style.display = 'none';
                newInput.value = '';
            }
        }

        // Optional: AJAX form submission to dynamically update dropdown
        document.getElementById('addCandidateForm').addEventListener('submit', function(e) {
            e.preventDefault();

            const formData = new FormData(this);
            fetch('@Url.Action("AddCandidate", "Admin")', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('Candidate added successfully!');

                    // Update dropdown if new position was added
                    if (data.newPosition) {
                        const dropdown = document.getElementById('positionDropdown');
                        const option = document.createElement('option');
                        option.value = data.newPosition;
                        option.text = data.newPosition;
                        dropdown.insertBefore(option, dropdown.querySelector('option[value="__new"]'));
                        dropdown.value = data.newPosition;
                    }

                    // Reset form
                    this.reset();
                    document.getElementById('newPositionInput').style.display = 'none';
                } else {
                    alert('Error adding candidate: ' + data.error);
                }
            })
            .catch(err => console.error(err));
        });
    </script>
}
