@model VotingSystem.Models.Candidates

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add Candidate";
    ViewBag.Active = "AddCandidate";
    var positions = ViewBag.Positions as List<string>;
}

<div class="container-fluid py-4">
    <!-- ===== Page Header ===== -->
    <div class="d-flex justify-content-between align-items-center mb-4 px-3 py-2 rounded-3 shadow-sm bg-white border">
        <div class="d-flex align-items-center">
            <div class="me-2 text-success">
                <i class="bi bi-person-plus-fill fs-3"></i>
            </div>
            <div>
                <h4 class="fw-bold text-success mb-0">Add New Candidate</h4>
                <p class="text-muted mb-0 small">Register a new candidate for the election</p>
            </div>
        </div>
        <button class="btn btn-outline-primary btn-sm rounded-pill" onclick="location.href='@Url.Action("Candidates", "Admin")'">
            <i class="bi bi-people-fill me-1"></i> View All Candidates
        </button>
    </div>

    <!-- ===== Add Candidate Form ===== -->
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-5">
                    <h5 class="fw-semibold text-dark mb-4">
                        <i class="bi bi-pencil-square me-2 text-primary"></i> Candidate Information
                    </h5>

                    <form asp-action="AddCandidate" method="post">
                        <!-- Candidate Name -->
                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-semibold text-secondary">
                                <i class="bi bi-person-fill me-2 text-success"></i>Candidate Name
                            </label>
                            <input asp-for="Name" class="form-control form-control-lg rounded-3 shadow-sm-sm" placeholder="Enter candidate name" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <!-- Party -->
                        <div class="mb-4">
                            <label asp-for="Party" class="form-label fw-semibold text-secondary">
                                <i class="bi bi-flag-fill me-2 text-primary"></i>Party
                            </label>
                            <input asp-for="Party" class="form-control form-control-lg rounded-3 shadow-sm-sm" placeholder="Enter party name" />
                            <span asp-validation-for="Party" class="text-danger small"></span>
                        </div>

                        <!-- Position -->
                        <div class="mb-4">
                            <label asp-for="Position" class="form-label fw-semibold text-secondary">
                                <i class="bi bi-briefcase-fill me-2 text-warning"></i>Position
                            </label>
                            <select asp-for="Position" class="form-select form-select-lg rounded-3 shadow-sm-sm" asp-items="@(new SelectList(positions))">
                                <option value="">-- Select Position --</option>
                            </select>
                            <span asp-validation-for="Position" class="text-danger small"></span>
                        </div>

                        <!-- Divider -->
                        <hr class="my-4">

                        <!-- Buttons -->
                        <div class="d-flex justify-content-end gap-3">
                            <a asp-action="AdminDashboard" class="btn btn-outline-secondary px-4 py-2 rounded-3">
                                <i class="bi bi-arrow-left me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-success px-4 py-2 rounded-3">
                                <i class="bi bi-save2 me-1"></i> Save Candidate
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
