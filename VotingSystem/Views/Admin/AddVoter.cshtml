@model VotingSystem.Models.User
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add Voter";
}

<style>
    /* Container */
    .form-card {
        max-width: 600px;
        margin: 40px auto;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        overflow: hidden;
        border: 1px solid #e0e0e0;
    }

        /* Card header */
        .form-card .card-header {
            background: linear-gradient(135deg, #007bff, #00c6ff);
            color: #fff;
            text-align: center;
            padding: 1.25rem 1rem;
            font-size: 1.25rem;
            font-weight: 700;
        }

        /* Form controls */
        .form-card .form-control {
            border-radius: 8px;
            padding: 10px 14px;
            border: 1px solid #ccc;
            font-size: 15px;
            transition: 0.2s;
        }

            .form-card .form-control:focus {
                border-color: #007bff;
                box-shadow: 0 0 5px rgba(0,123,255,0.3);
            }

        .form-card .form-label {
            font-weight: 600;
            color: #34495e;
        }

        .form-card .text-danger {
            font-size: 14px;
        }

        /* Buttons */
        .form-card .btn {
            font-weight: 600;
            border-radius: 8px;
            font-size: 15px;
            padding: 10px 18px;
            transition: 0.2s;
        }

        .form-card .btn-success {
            background-color: #27ae60;
            border-color: #27ae60;
        }

            .form-card .btn-success:hover {
                background-color: #239b56;
            }

        .form-card .btn-secondary {
            background-color: #7f8c8d;
            border-color: #7f8c8d;
        }

            .form-card .btn-secondary:hover {
                background-color: #707b7c;
            }

        .form-card .btn i {
            margin-right: 6px;
        }

        /* Form spacing */
        .form-card .mb-3 {
            margin-bottom: 1.25rem;
        }

        .form-card .d-flex.gap-2 {
            gap: 10px;
        }
</style>

<div class="form-card card shadow-lg">
    <div class="card-header">
        <i class="bi bi-person-plus-fill me-2"></i> Add Voter
    </div>
    <div class="card-body p-4">
        <form asp-action="AddVoter" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" placeholder="Enter username" required />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" placeholder="Enter full name" required />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Enter password" required />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success flex-fill">
                    <i class="bi bi-check2-circle"></i> Add Voter
                </button>
                <a asp-action="ManageVoters" class="btn btn-secondary flex-fill">
                    <i class="bi bi-x-circle"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
