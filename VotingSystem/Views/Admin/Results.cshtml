@model IEnumerable<VotingSystem.Models.Candidates>

@{
    ViewData["Title"] = "Election Results";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    /* ===== PAGE STYLING ===== */
    .results-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    h1.page-title {
        font-size: 2.5rem;
        font-weight: 700;
        background: linear-gradient(90deg, #007bff, #6610f2);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: 0.5px;
    }

    h3.position-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #343a40;
        margin-bottom: 1.5rem;
        border-left: 6px solid #007bff;
        padding-left: 12px;
    }

    /* ===== CARD STYLING ===== */
    .candidate-card {
        border: none;
        border-radius: 1rem;
        transition: 0.3s ease;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    }

        .candidate-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 25px rgba(0, 0, 0, 0.12);
        }

    .card-body {
        padding: 1.8rem;
    }

    .card-title {
        font-size: 1.3rem;
        font-weight: 700;
        color: #222;
    }

    .card-text {
        font-size: 1rem;
    }

    .party-text {
        color: #6c757d;
        font-weight: 500;
    }

    /* ===== VOTES SECTION ===== */
    .vote-count {
        font-size: 1rem;
        font-weight: 600;
        color: #198754;
        margin-bottom: 0.5rem;
    }

    .progress {
        height: 0.8rem;
        background-color: #f1f3f5;
        border-radius: 10px;
    }

    .progress-bar {
        transition: width 1s ease;
        border-radius: 10px;
    }

    .winner-badge {
        background: linear-gradient(135deg, #FFD700, #ffcc00);
        color: #000;
        font-weight: 700;
        text-transform: uppercase;
        border-radius: 8px;
        padding: 0.5rem 0.75rem;
        margin-top: 1rem;
        font-size: 0.9rem;
    }

    .alert {
        border-radius: 10px;
    }
</style>

<div class="results-container container py-5">
    <div class="text-center mb-5">
        <h1 class="page-title">Election Results</h1>
        <p class="text-muted fs-5">Review the election outcomes by position and see who won each category.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center shadow-sm">
            <i class="bi bi-info-circle-fill me-2"></i>No votes have been cast yet.
        </div>
    }
    else
    {
        @foreach (var group in Model.GroupBy(c => c.Position))
        {
            var maxVotes = group.Max(c => c.Votes);
            var totalVotes = group.Sum(c => c.Votes) == 0 ? 1 : group.Sum(c => c.Votes);

            <div class="mb-5">
                <h3 class="position-title">@group.Key</h3>

                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                    @foreach (var candidate in group.OrderByDescending(c => c.Votes))
                    {
                        var percentage = Math.Round((double)candidate.Votes / totalVotes * 100, 1);

                        <div class="col">
                            <div class="candidate-card h-100">
                                <div class="card-body d-flex flex-column justify-content-between">
                                    <div>
                                        <h5 class="card-title">@candidate.Name</h5>
                                        <p class="party-text mb-2">
                                            <i class="bi bi-flag-fill me-1 text-primary"></i>@candidate.Party
                                        </p>

                                        <p class="vote-count">
                                            <i class="bi bi-bar-chart-line me-1"></i>@candidate.Votes votes
                                            <span class="text-muted">(@percentage%)</span>
                                        </p>

                                        <div class="progress mb-2">
                                            <div class="progress-bar bg-success" role="progressbar"
                                                 style="width: @percentage%" aria-valuenow="@percentage"
                                                 aria-valuemin="0" aria-valuemax="100">
                                            </div>
                                        </div>
                                    </div>

                                    @if (candidate.Votes == maxVotes)
                                    {
                                        <div class="text-center mt-3">
                                            <span class="winner-badge">
                                                <i class="bi bi-trophy-fill me-1"></i> Winner
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>
